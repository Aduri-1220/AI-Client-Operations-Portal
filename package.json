{
  "name": "ai-client-operations-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run start:dev --prefix apps/api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "build:web": "npm run build --prefix apps/web",
    "build:api": "npm run build --prefix apps/api",
    "build:mcp": "npm run build --prefix apps/mcp-server",
    "build": "npm run build:web && npm run build:api && npm run build:mcp",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:api": "npm test --prefix apps/api",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "lint": "npm run lint --prefix apps/web && npm run lint --prefix apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
