{
  "id": "a23879c7-4e1d-4187-b9c4-8b3e6ef1c24c",
  "name": "Client Onboarding Workflow",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook — New Client Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "33333cef-30bf-40e5-9f9a-440cb0a4cc39",
      "parameters": {
        "path": "client-created",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "2",
      "name": "Send Welcome Email (stub — needs real SMTP/SendGrid before demo)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [450, 300],
      "parameters": {}
    },
    {
      "id": "3",
      "name": "Create Default Project",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/projects",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "name", "value": "=Onboarding — {{ $json.body.name }}" },
            { "name": "clientId", "value": "={{ $json.body.id }}" },
            { "name": "status", "value": "PLANNING" },
            { "name": "budget", "value": 0 },
            { "name": "startDate", "value": "={{ new Date().toISOString().split('T')[0] }}" },
            { "name": "deadline", "value": "={{ new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0] }}" }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Notify Internal Team",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [950, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "=:tada: New client onboarded: *{{ $node[\"Webhook — New Client Created\"].json.body.name }}*. Project created: {{ $json.name }}. Please review and assign team." }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook — New Client Created": { "main": [[{ "node": "Send Welcome Email (stub — needs real SMTP/SendGrid before demo)", "type": "main", "index": 0 }]] },
    "Send Welcome Email (stub — needs real SMTP/SendGrid before demo)": { "main": [[{ "node": "Create Default Project", "type": "main", "index": 0 }]] },
    "Create Default Project": { "main": [[{ "node": "Notify Internal Team", "type": "main", "index": 0 }]] }
  }
}
